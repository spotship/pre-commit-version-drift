{
	"name": "pre-commit-version-drift",
	"devDependencies": {
		"semantic-release": "^25.0.3"
	},
	"scripts": {
		"semantic-release": "semantic-release"
	},
	"release": {
		"plugins": [
			[
				"@semantic-release/commit-analyzer",
				{
					"releaseRules": [
						{
							"type": "chore",
							"scope": "deps",
							"release": "patch"
						}
					]
				}
			],
			"@semantic-release/release-notes-generator",
			"@semantic-release/github"
		],
		"branches": [
			{
				"name": "main",
				"prerelease": false
			}
		]
	},
	"version": "0.0.0-development",
	"repository": {
		"type": "git",
		"url": "https://github.com/spotship/pre-commit-version-drift.git"
	},
	"publishConfig": {
		"access": "restricted"
	}
}
